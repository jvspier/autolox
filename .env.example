# autolox — connection & credentials
#
# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` — it's in .gitignore.
# Set permissions to 600 to keep it readable only by you:
#   chmod 600 .env
#
# Precedence (highest first):
#   1. shell environment (e.g., `LOXONE_PW=... python ...`)
#   2. this file
#   3. CLI --flag
#   4. getpass prompt (for passwords only)

# --- connection ---
# LAN IPs of ALL Miniservers in the (Trust) cluster. Comma-separated.
# The tool queries each one for its own NfcCodeTouch readers, then routes
# per-reader commands to whichever Miniserver reported that reader. This
# is necessary because a non-admin user's LoxAPP3.json only shows the
# controls on the specific Miniserver being queried — NOT the merged
# cluster view. Without every host listed, readers on unlisted Miniservers
# are invisible.
#
# For a single-Miniserver install, either set LOXONE_HOSTS with one entry
# OR use LOXONE_HOST (legacy single-value form). LOXONE_HOSTS wins if both
# are set.
LOXONE_HOSTS=192.0.2.10,192.0.2.11,192.0.2.12,192.0.2.13

# LAN IP of the Miniserver where the target Loxone user object lives.
# getuserlist2 and addusernfc go here. If omitted, defaults to the first
# host in LOXONE_HOSTS.
LOXONE_USER_HOST=192.0.2.1

# --- credentials ---
# Loxone service account for the tool. See docs/workflow.md for how to
# set this up (needs User Management right + access to the target reader).
LOXONE_USER=svc.cardenroll
LOXONE_PW=change-me
LOXONE_VISU_PW=change-me

# The reader and target user are chosen per session in the web UI's
# dropdowns. CLI users can pass --code-touch and --user-uuid on the
# command line; see `loxone_bulk_enroll.py --help` for details.
