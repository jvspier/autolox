# autolox — connection & credentials
#
# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` — it's in .gitignore.
# Set permissions to 600 to keep it readable only by you:
#   chmod 600 .env
#
# Precedence (highest first):
#   1. shell environment (e.g., `LOXONE_PW=... python ...`)
#   2. this file
#   3. CLI --flag
#   4. getpass prompt (for passwords only)

# --- connection ---
# LAN IP of the Miniserver that OWNS the target NFC Code Touch reader.
# Receives learn-mode commands and hosts the state-stream websocket.
LOXONE_HOST=192.0.2.10

# LAN IP of the Miniserver where the target Loxone user object lives.
# In a Trust cluster this may differ from LOXONE_HOST.
# If omitted, defaults to LOXONE_HOST.
LOXONE_USER_HOST=192.0.2.1

# --- credentials ---
# Loxone service account for the tool. See docs/workflow.md for how to
# set this up (needs User Management right + access to the target reader).
LOXONE_USER=svc.cardenroll
LOXONE_PW=change-me
LOXONE_VISU_PW=change-me

# --- session scope — pass on the command line, don't set here ---
#
# The reader and target user are SESSION choices, not connection config.
# Different seasons use different target users; different runs may use
# different readers. Keep them out of .env so nothing in the environment
# silently pins your session to a stale choice.
#
# In phase 3 (web app) these will become dropdowns on the enrolment screen,
# populated from getuserlist2 and the merged LoxAPP3.json. Until then, pass
# them via CLI flags each run:
#
#   python loxone_bulk_enroll.py --code-touch <reader-uuid> \
#                                --user-uuid <target-user-uuid> \
#                                --names names.txt
#
# If you REALLY want to default them for a single-purpose test setup, the
# env vars exist — but resist unless you're sure. The commented lines below
# show the shape:
#
# LOXONE_CODE_TOUCH_UUID=xxxxxxxx-xxxx-xxxx-xxxxYYYYYYYYYYYY
# LOXONE_TARGET_USER_UUID=xxxxxxxx-xxxx-xxxx-xxxxYYYYYYYYYYYY
